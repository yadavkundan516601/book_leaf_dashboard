# ---------------------------------------------------------------------------
# BookLeaf Support Portal - server configuration
# Copy to server/.env (cp server/.env.example server/.env).
# Works as it is for local development. Empty values and "<PLACEHOLDER>" values
# count as not set, so leaving a placeholder unedited is safe.
# ---------------------------------------------------------------------------

# server
NODE_ENV="development"  # development | test | production
PORT="4000"  # port the API and the built web app listen on
LOG_LEVEL="info"  # fatal | error | warn | info | debug | trace | silent
SERVE_WEB="true"  # serve the built web app (web/dist) from this process
TRUST_PROXY="false"  # set true behind Render / nginx / a load balancer
CORS_ORIGIN=" http://localhost:5173"  # only if the web app runs on another origin, e.g. http://localhost:5173

# database
DATABASE_URL="<POSTGRES_URL>"  # postgres://user:password@host:5432/bookleaf; unset = embedded dev database (required in production)
PGLITE_DATA_DIR=".data/pglite"  # where the embedded database keeps its files; "memory" = throwaway
DB_AUTO_MIGRATE="true"  # run migrations on boot
DB_AUTO_SEED="true"  # load the sample authors and books on boot (safe to repeat)
SEED_DEMO_HISTORY="true"  # fresh database only: add ~4 weeks of resolved demo tickets for the dashboard

# auth
JWT_SECRET="<RANDOM_SECRET_32_CHARS_OR_MORE>"  # required in production; generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_TTL_HOURS="12"  # how long a sign-in lasts
SEED_AUTHOR_PASSWORD="Author@123"  # password for the demo author accounts; change on any shared deployment
SEED_ADMIN_PASSWORD="Admin@123"  # password for the demo admin accounts; change on any shared deployment

# ai - gemini (primary)
GEMINI_API_KEY=""  # free key: https://aistudio.google.com/apikey (GOOGLE_API_KEY also works); unset = rules and templates only
AI_PROVIDER="auto"  # auto = Gemini if its key is set, else Anthropic if its key is set | gemini | anthropic
AI_CLASSIFY_MODEL=""  # triage model; empty = gemini-3.5-flash-lite (a missing model falls back automatically)
AI_DRAFT_MODEL=""  # drafts, refine and instant answers; empty = gemini-3.6-flash
AI_FREE_TIER=""  # true = report AI cost as $0; empty = on for Gemini, off for Anthropic

# ai - limits and resilience
AI_RPM_LIMIT="12"  # requests per minute from this server, keeps you inside free-tier limits
AI_QUEUE_WAIT_MS="8000"  # wait this long for a free slot, then fall back to rules/templates
AI_TIMEOUT_MS="30000"  # per request timeout (the first request to a model after idle can be slow; the server warms models up at startup)
AI_MAX_RETRIES="2"  # retries for rate-limit / overload / network errors
AI_BREAKER_THRESHOLD="3"  # consecutive failures before AI calls pause
AI_BREAKER_COOLDOWN_MS="60000"  # how long the pause lasts before one trial call
AI_CLASSIFY_CONCURRENCY="3"  # tickets triaged in parallel in the background
AI_DISABLED="false"  # true = force rules/templates mode even with a key

# ai - anthropic (optional alternative to Gemini)
ANTHROPIC_API_KEY="<YOUR_ANTHROPIC_API_KEY>"  # only if AI_PROVIDER=anthropic (default models: claude-haiku-4-5)
AI_BASE_URL=""  # optional override for the Anthropic endpoint
