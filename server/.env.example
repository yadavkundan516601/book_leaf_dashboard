# BookLeaf Support Portal - server configuration
#
# Local setup:   cp server/.env.example server/.env
# Everything below is optional for local development. With no changes the app
# runs on an embedded database and in AI "degraded" mode (rules + templates).
# Never commit the real .env file; it is gitignored.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=4000
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# Serve the built web app (web/dist) from this process. Keep true unless the
# frontend is hosted separately.
SERVE_WEB=true

# Set to true when running behind a reverse proxy / load balancer (Render, nginx, ...)
# so client IPs (rate limiting) and HTTPS are detected correctly.
TRUST_PROXY=false

# Only needed when the web app is served from a DIFFERENT origin than the API,
# e.g. http://localhost:5173 if you bypass the Vite proxy. Leave unset otherwise.
# CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset to use the embedded PGlite database (local dev only).
# REQUIRED in production.
# DATABASE_URL=postgres://user:password@localhost:5432/bookleaf

# Where the embedded database stores its files. Use "memory" for a throwaway DB.
PGLITE_DATA_DIR=.data/pglite

# Run migrations and the idempotent seed (provided dataset + demo tickets) on boot.
DB_AUTO_MIGRATE=true
DB_AUTO_SEED=true

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# REQUIRED in production (32+ characters). In development an insecure built-in
# secret is used and a warning is logged.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=

# Session lifetime in hours.
JWT_TTL_HOURS=12

# Passwords for the seeded demo accounts (authors use the first, admins the second).
# Change these on any shared or public deployment.
SEED_AUTHOR_PASSWORD=Author@123
SEED_ADMIN_PASSWORD=Admin@123

# ---------------------------------------------------------------------------
# AI (Anthropic Claude)
# ---------------------------------------------------------------------------
# Without a key the app still works: tickets are classified by a rules engine
# and drafts come from policy templates. Server-side only - never exposed to the browser.
# ANTHROPIC_API_KEY=

# Models are configurable per task. Haiku 4.5 is fast and cheap for both.
AI_CLASSIFY_MODEL=claude-haiku-4-5
AI_DRAFT_MODEL=claude-haiku-4-5

# API endpoint. Set explicitly so a host-level ANTHROPIC_BASE_URL (e.g. a dev
# proxy) is never picked up by accident. Change only for a gateway you trust.
AI_BASE_URL=https://api.anthropic.com

# Per-request timeout (ms) and SDK retries for 429 / 5xx / network errors.
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2

# Circuit breaker: after this many consecutive failures, skip AI calls for the
# cooldown (ms), then allow one trial call. Auth errors open it immediately.
AI_BREAKER_THRESHOLD=3
AI_BREAKER_COOLDOWN_MS=60000

# How many tickets are classified in parallel in the background.
AI_CLASSIFY_CONCURRENCY=3

# Kill switch: force degraded mode (rules + templates) without removing the key.
AI_DISABLED=false
