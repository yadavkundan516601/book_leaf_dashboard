# Copy to server/.env for local development. Never commit the real file.

# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database ---
# Leave DATABASE_URL unset to use the embedded PGlite database in .data/pglite.
# DATABASE_URL=postgres://user:password@localhost:5432/bookleaf
# PGLITE_DATA_DIR=.data/pglite
DB_AUTO_MIGRATE=true
DB_AUTO_SEED=true

# --- Auth ---
# Required in production (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
JWT_TTL_HOURS=12

# --- AI (optional: without a key the app runs in degraded mode) ---
# ANTHROPIC_API_KEY=
AI_CLASSIFY_MODEL=claude-haiku-4-5
AI_DRAFT_MODEL=claude-haiku-4-5
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_BREAKER_THRESHOLD=3
AI_BREAKER_COOLDOWN_MS=60000
AI_CLASSIFY_CONCURRENCY=3
AI_DISABLED=false

# --- Demo seed credentials ---
SEED_AUTHOR_PASSWORD=Author@123
SEED_ADMIN_PASSWORD=Admin@123
