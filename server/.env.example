# Copy to server/.env. Works as-is for local development.

# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
SERVE_WEB=true
TRUST_PROXY=false
# CORS_ORIGIN=http://localhost:5173

# Database (leave DATABASE_URL unset to use the embedded dev database)
# DATABASE_URL=postgres://user:password@localhost:5432/bookleaf
PGLITE_DATA_DIR=.data/pglite
DB_AUTO_MIGRATE=true
DB_AUTO_SEED=true

# Auth (JWT_SECRET required in production, 32+ chars)
# JWT_SECRET=
JWT_TTL_HOURS=12
SEED_AUTHOR_PASSWORD=Author@123
SEED_ADMIN_PASSWORD=Admin@123
# Fresh database only: add ~4 weeks of resolved demo tickets for the admin dashboard
SEED_DEMO_HISTORY=true

# AI (without a key the app runs on rules + templates)
# Gemini (primary, free tier friendly). GOOGLE_API_KEY is also accepted.
# GEMINI_API_KEY=
# auto = Gemini if its key is set, else Anthropic if its key is set; or force gemini|anthropic
AI_PROVIDER=auto
# Model ids default per provider (gemini: gemini-3.5-flash-lite / gemini-3.8-flash; unavailable ids fall back automatically)
# AI_CLASSIFY_MODEL=gemini-3.5-flash-lite
# AI_DRAFT_MODEL=gemini-3.8-flash
# Client-side pacing for the whole process (free tier); waiting longer than AI_QUEUE_WAIT_MS falls back to rules/templates
AI_RPM_LIMIT=12
AI_QUEUE_WAIT_MS=8000
# Report LLM cost as $0 (defaults to true for Gemini, false for Anthropic)
# AI_FREE_TIER=true
# Anthropic (optional alternative; models default to claude-haiku-4-5)
# ANTHROPIC_API_KEY=
# AI_BASE_URL=https://api.anthropic.com
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_BREAKER_THRESHOLD=3
AI_BREAKER_COOLDOWN_MS=60000
AI_CLASSIFY_CONCURRENCY=3
AI_DISABLED=false
